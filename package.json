{
  "name": "trackport",
  "version": "1.0.0",
  "description": "Student developer productivity and progress-tracking platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix Backend run dev",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build": "npm --prefix Frontend run build",
    "build:frontend": "npm --prefix Frontend run build",
    "start:backend": "npm --prefix Backend start",
    "start:frontend": "npm --prefix Frontend run preview"
  },
  "keywords": [
    "developer",
    "productivity",
    "portfolio",
    "mern",
    "tasks",
    "projects"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
